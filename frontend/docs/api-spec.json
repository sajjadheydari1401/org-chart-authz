  "info": {
    "title": "org-chart-authz-backend — Hierarchical RBAC + ABAC",
    "description": "Dynamic authorization API: roles, permissions, grant-scoped ABAC policies, and a demo articles resource.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "Permission": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "rolePermissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolePermission"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "key",
          "description",
          "rolePermissions",
          "createdAt",
          "updatedAt"
        ]
      },
      "Policy": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "effect": {
            "enum": ["permit", "deny"],
            "type": "string"
          },
          "conditions": {
            "type": "object",
            "additionalProperties": true
          },
          "rolePermission": {
            "$ref": "#/components/schemas/RolePermission"
          },
          "rolePermissionId": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "effect",
          "conditions",
          "rolePermission",
          "rolePermissionId",
          "createdAt",
          "updatedAt"
        ]
      },
      "RolePermission": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "roleId": {
            "type": "string"
          },
          "permission": {
            "$ref": "#/components/schemas/Permission"
          },
          "permissionId": {
            "type": "string"
          },
          "policies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Policy"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "roleId",
          "permission",
          "permissionId",
          "policies",
          "createdAt"
        ]
      },
      "UserRole": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "roleId": {
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["id", "userId", "role", "roleId", "createdAt"]
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "parent": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "parentId": {
            "type": "string",
            "nullable": true
          },
          "rolePermissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolePermission"
            }
          },
          "userRoles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserRole"
            }
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "children",
          "parent",
          "parentId",
          "rolePermissions",
          "userRoles",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateRoleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "description": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "description": "Parent role id; the parent inherits this role's permissions.",
            "format": "uuid"
          }
        },
        "required": ["name"]
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {}
      },
      "SetRolePermissionsDto": {
        "type": "object",
        "properties": {
          "permissionKeys": {
            "description": "Permission keys granted directly to the role (replaces existing set).",
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["permissionKeys"]
      },
      "CreatePermissionDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["key"]
      },
      "UpdatePermissionDto": {
        "type": "object",
        "properties": {}
      },
      "CreatePolicyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "effect": {
            "type": "string",
            "enum": ["permit", "deny"]
          },
          "conditions": {
            "type": "object",
            "additionalProperties": true,
            "description": "JSON condition tree, see PolicyEngine for the grammar."
          }
        },
        "required": ["name", "effect", "conditions"]
      },
      "UpdatePolicyDto": {
        "type": "object",
        "properties": {}
      },
      "SetUserRolesDto": {
        "type": "object",
        "properties": {
          "roleIds": {
            "description": "Role ids assigned to the user (replaces existing set).",
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": ["roleIds"]
      },
      "Article": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "ownerId": {
            "type": "string",
            "description": "Id of the user who created the article (from request.user.id)."
          },
          "status": {
